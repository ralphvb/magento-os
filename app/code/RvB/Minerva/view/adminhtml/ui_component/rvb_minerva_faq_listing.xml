<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <!-- Definición de DataProviders (di.xml) -->
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">rvb_minerva_faq_listing.rvb_minerva_faq_listing_data_source</item>
            <!-- Convención de nombres para Data Provider de UI Grids Components vendor_module_model_listing.vendor_module_entity_data_source -->
            <!-- Convención de nombres para Data Provider de UI Grids Components nombre_del_ui_component.nombre_del_data_source -->
        </item>
        <item name="buttons" xsi:type="array">
            <item name="add" xsi:type="array">
                <item name="name" xsi:type="string">add</item>
                <item name="label" xsi:type="string" translate="true">Add New FAQ</item>
                <item name="url" xsi:type="string">minerva/faq/new</item>
                <item name="class" xsi:type="string">primary</item>
            </item>
        </item>
    </argument>
    <settings>
        <deps>
            <dep>rvb_minerva_faq_listing.rvb_minerva_faq_listing_data_source</dep>
            <!-- Convención de nombres para Dependency de UI Grids Components el mismo que el Data Provider de arriba -->
        </deps>
        <!-- Convención de nombres para Spinner de UI Grids Components vendor_module_entity_spinner -->
        <spinner>rvb_minerva_faq_columns</spinner>
    </settings>
    <!-- Convención de nombres para Data Source Node de UI Grids Components nombre_del_data_source -->
    <dataSource name="rvb_minerva_faq_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <!-- config para crash de caché para sorting de columnas -->
                <!-- <param name="cacheRequests" xsi:type="boolean">false</param> -->
                <!-- config para crash de caché para sorting de columnas mediante primaryFieldName -->
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <!-- updateUrl oblogatorio para render del Grid -->
            <updateUrl path="mui/index/render" />
        </settings>
        <!-- aclResource opcional -->
        <aclResource>RvB_Minerva::faq</aclResource>
        <!-- Convención de nombres para Data Provider de UI Grids Components el mismo que el Data Source en di.xml -->
        <dataProvider name="rvb_minerva_faq_listing_data_source" class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <!-- Aquí es el nombre de la llave primaria de la tabla -->
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <paging name="listing_paging" />
        <columnsControls name="columns_controls" />
        <bookmark name="bookmarks" />
        <filters name="listing_filters">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="applied" xsi:type="array">
                        <item name="is_published" xsi:type="string">1</item>
                    </item>
                </item>
            </argument>
        </filters>
        <filterSearch name="fulltext" />
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <settings>
                <!-- Convención de nombres para provider del settings del columns de UI Grids Components para massactions nombre_del_ui_component.nombre_del_ui_component.nombre_del_nodo_columnas.nombre_del_selectionColumns -->
                <selectProvider>rvb_minerva_faq_listing.rvb_minerva_faq_listing.rvb_minerva_faq_columns.ids</selectProvider>
                <indexField>id</indexField>
            </settings>
            <action name="delete">
                <settings>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <url path="*/*/massDelete" />
                    <confirm>
                        <title translate="true">Delete items</title>
                        <message translate="true">Are you sure you want to delete the selected items?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <!-- Convención de nombres para Columns de UI Grids Components vendor_module_entity_columns -->
    <columns name="rvb_minerva_faq_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <!-- Convención de nombres para provider del settings del columns de UI Grids Components para redirect on click nombre_del_ui_component.nombre_del_ui_component.nombre_del_nodo_columnas.nombre_del_actionsColumn
                    <item name="provider" xsi:type="string">rvb_minerva_faq_listing.rvb_minerva_faq_listing.rvb_minerva_faq_columns.actions</item> -->
                    <!-- Convención de nombres para provider del settings del columns de UI Grids Components para inline edit nombre_del_ui_component.nombre_del_ui_component.nombre_del_nodo_columnas_editor -->
                    <item name="provider" xsi:type="string">rvb_minerva_faq_listing.rvb_minerva_faq_listing.rvb_minerva_faq_columns_editor</item>
                    <!-- Redirect on click: vendor/magento/module-ui/view/base/web/js/grid/columns/actions.js
                    <item name="target" xsi:type="string">applyAction</item> -->
                    <!-- Inline Edit: vendor/magento/module-ui/view/base/web/js/grid/editing/editor.js -->
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <!-- app/code/RvB/Minerva/Ui/Component/Listing/Columns/Actions.php
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item> -->
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="*/*/inlineEdit" />
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <!-- Convención de nombres para provider del inline editor de UI Grids Components para redirect on click nombre_del_ui_component.nombre_del_ui_component.nombre_del_nodo_columnas.ids -->
                <param name="selectProvider" xsi:type="string">rvb_minerva_faq_listing.rvb_minerva_faq_listing.rvb_minerva_faq_columns.ids</param>
                <param name="indexField" xsi:type="string">id</param>
                <param name="enabled" xsi:type="boolean">true</param>
            </editorConfig>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>id</indexField>
            </settings>
        </selectionsColumn>
        <!-- Se define columna por atributo de la entidad que queramos mostrar -->
        <column name="id">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="question">
            <settings>
                <label translate="true">Question</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="answer">
            <settings>
                <label translate="true">Answer</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="is_published" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <dataType>select</dataType>
                <label translate="true">Is Published?</label>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <sorting>desc</sorting>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="created_at" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">Created At</label>
                <filter>dateRange</filter>
            </settings>
        </column>
        <column name="updated_at" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">Updated At</label>
                <timezone>false</timezone>
                <dateFormat>dd/MM/yyyy hh:mm:ss</dateFormat>
                <filter>dateRange</filter>
            </settings>
        </column>
        <actionsColumn name="actions" class="RvB\Minerva\Ui\Component\Listing\Columns\Actions">
        </actionsColumn>
    </columns>
</listing>